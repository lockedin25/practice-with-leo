# Required: every director and interviewer turn is LLM-driven through OpenRouter.
OPENROUTER_API_KEY=

# Quality-first default for a natural, concise interviewer. Any current
# OpenRouter model slug can be substituted here.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# OpenRouter tries the primary model first, then these models in order if it is
# unavailable. Leave blank to use provider-level routing only.
OPENROUTER_FALLBACK_MODELS=~openai/gpt-latest

# --- ElevenLabs voice transport ------------------------------------------
# "realtime" is push-to-talk: the browser streams microphone audio straight to
#   Scribe and Leo's reply straight to speech synthesis, and the spacebar marks
#   the turn boundary. There is no ElevenLabs Agent, nothing calls back into
#   this server, and local development needs no public HTTPS tunnel.
# "custom" preserves the existing FastAPI/OpenRouter Custom LLM adapter.
# "native" uses an ElevenLabs-hosted LLM and the guarded case-facts webhook.
# The two agent modes are unchanged and still supported; realtime is the
# low-latency path and is what the room offers when it is selected.
VOICE_ENABLED=false
ELEVENLABS_VOICE_MODE=realtime
ELEVENLABS_API_KEY=
ELEVENLABS_ENVIRONMENT=development

# Required by realtime mode. The Agent used to carry its own voice; the raw
# text-to-speech endpoint takes the voice as a URL segment, so it has to be
# named here. Copy the ID from any voice on your ElevenLabs Voices page.
ELEVENLABS_VOICE_ID=

# Realtime transport tuning. The defaults are the low-latency choices and
# rarely need changing. Note that only pcm_44100 requires a paid ElevenLabs
# tier: pcm_24000 streams into a plain AudioContext on every plan.
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_24000

# Only the two agent modes need an agent. Realtime mode ignores this.
ELEVENLABS_AGENT_ID=

# --- Spoken interviewer (realtime mode) ----------------------------------
# A spoken turn is one fused streaming call rather than the three to five
# sequential calls typed chat makes, so speech can begin on Leo's first
# sentence instead of his last token. It runs on the same OpenRouter key as
# everything else: no second provider and no extra credential.
#
# The model matters far more than the provider here. Measured by
# scripts/bench_turn.py on a real fused turn, time from request to the first
# speakable sentence plus ~0.15s for the first audio chunk:
#   google/gemini-3.7-flash        4.81s   reasons ~4.5s before emitting
#   anthropic/claude-sonnet-4.6    2.38s   best answer quality
#   openai/gpt-4o-mini             2.10s   fastest, weaker judgement
# A model that reasons silently and then emits its whole answer at once cannot
# be spoken clause by clause however fast its total is, so the spoken path
# always sends reasoning={"exclude": true}. Re-run the bench before changing
# this; the ranking is account and region dependent.
#
# Leave blank to reuse OPENROUTER_MODEL, but note that a reasoning-heavy chat
# default is usually the wrong choice for speech. Do not reach for a small
# model either: collapsing five calls into one already buys the latency back.
VOICE_OPENROUTER_MODEL=

# Completion ceiling for one spoken turn. Two short sentences need very little;
# the larger chat budget in app/llm_budget.py is sized for reasoning preamble.
VOICE_COMPLETION_TOKENS=700

# --- Google sign-in -------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and register this exact
# redirect URI on it: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the client above, scheme and port
# included. Cookies are marked Secure automatically when this is https.
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Signs the session cookie. Leave blank in development and one is generated
# into data/.session_secret. Set it explicitly in production so sessions
# survive a deploy, and keep it out of version control.
SESSION_SECRET=

# Comma-separated addresses allowed to open /admin. Until this is set nobody
# is an administrator, including the first account to sign in.
ADMIN_EMAILS=

# Optional. Restrict sign-in to these email domains, comma separated.
# Leave blank to accept any Google account.
ALLOWED_EMAIL_DOMAINS=
