# Required: every director and interviewer turn is LLM-driven through OpenRouter.
OPENROUTER_API_KEY=

# Quality-first default for a natural, concise interviewer. Any current
# OpenRouter model slug can be substituted here.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional fast model used only for spoken turns. Keep this empty to use
# OPENROUTER_MODEL for both chat and voice.
VOICE_OPENROUTER_MODEL=

# OpenRouter tries the primary model first, then these models in order if it is
# unavailable. Leave blank to use provider-level routing only.
OPENROUTER_FALLBACK_MODELS=~openai/gpt-latest

# --- ElevenLabs voice transport ------------------------------------------
# "custom" preserves the existing FastAPI/OpenRouter Custom LLM adapter.
# "native" uses an ElevenLabs-hosted LLM and the guarded case-facts webhook.
# Keep this set to custom until the native agent workflow has been configured
# and tested as described in docs/elevenlabs-native-agent-setup.md.
VOICE_ENABLED=false
ELEVENLABS_VOICE_MODE=custom
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_ENVIRONMENT=development

# Create this separate shared secret in the ElevenLabs Custom LLM configuration
# after Leo is deployed at a public HTTPS URL. It authenticates provider calls
# to POST /v1/chat/completions and is not the ElevenLabs API key.
ELEVENLABS_CUSTOM_LLM_SECRET=

# Required only when ELEVENLABS_VOICE_MODE=native. Create the same value as a
# secret in ElevenLabs and use it as the Bearer token on the get_case_facts
# webhook tool. This gives the native agent only approved facts, never database
# access or the complete case reservoir.
ELEVENLABS_CASE_TOOL_SECRET=

# Added after the public post-call reconciliation endpoint is enabled.
ELEVENLABS_WEBHOOK_SECRET=

# --- Google sign-in -------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and register this exact
# redirect URI on it: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the client above, scheme and port
# included. Cookies are marked Secure automatically when this is https.
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Signs the session cookie. Leave blank in development and one is generated
# into data/.session_secret. Set it explicitly in production so sessions
# survive a deploy, and keep it out of version control.
SESSION_SECRET=

# Comma-separated addresses allowed to open /admin. Until this is set nobody
# is an administrator, including the first account to sign in.
ADMIN_EMAILS=

# Optional. Restrict sign-in to these email domains, comma separated.
# Leave blank to accept any Google account.
ALLOWED_EMAIL_DOMAINS=
